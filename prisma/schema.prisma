model AssetType {
  id                 String            @id @default(cuid())
  organizationId     String?
  industryTemplateId String?
  name               String
  slug               String
  fieldSchema        Json?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  organization       Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  industryTemplate   IndustryTemplate? @relation(fields: [industryTemplateId], references: [id])
  assets             Asset[]

  @@unique([organizationId, slug])
  @@unique([industryTemplateId, slug])
  @@index([organizationId])
  @@index([industryTemplateId])
}

model Asset {
  id                 String           @id @default(cuid())
  organizationId     String
  customerId         String
  customerLocationId String
  assetTypeId        String?
  name               String
  manufacturer       String?
  modelNumber        String?
  serialNumber       String?
  installedAt        DateTime?
  warrantyExpiresAt  DateTime?
  warrantyStatus     String?
  lastServiceAt      DateTime?
  notesSummary       String?
  status             AssetStatus      @default(ACTIVE)
  customFields       Json?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer           Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerLocation   CustomerLocation @relation(fields: [customerLocationId], references: [id], onDelete: Cascade)
  assetType          AssetType?       @relation(fields: [assetTypeId], references: [id])
  workOrders         WorkOrder[]

  @@index([organizationId])
  @@index([customerId])
  @@index([customerLocationId])
  @@index([assetTypeId])
}

model ServiceCategory {
  id                 String              @id @default(cuid())
  organizationId     String?
  industryTemplateId String?
  name               String
  slug               String
  description        String?
  sortOrder          Int                 @default(0)
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organization       Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  industryTemplate   IndustryTemplate?   @relation(fields: [industryTemplateId], references: [id])
  serviceItems       ServiceItem[]
  workOrders         WorkOrder[]
  checklistTemplates ChecklistTemplate[]

  @@unique([organizationId, slug])
  @@unique([industryTemplateId, slug])
  @@index([organizationId])
  @@index([industryTemplateId])
}

model ServiceItem {
  id                 String              @id @default(cuid())
  organizationId     String?
  industryTemplateId String?
  serviceCategoryId  String?
  name               String
  slug               String
  description        String?
  defaultPrice       Decimal?            @db.Decimal(12, 2)
  defaultDurationMin Int?
  taxable            Boolean             @default(true)
  active             Boolean             @default(true)
  metadata           Json?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organization       Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  industryTemplate   IndustryTemplate?   @relation(fields: [industryTemplateId], references: [id])
  serviceCategory    ServiceCategory?    @relation(fields: [serviceCategoryId], references: [id])
  workOrders         WorkOrder[]
  quoteLineItems     QuoteLineItem[]
  invoiceLineItems   InvoiceLineItem[]
  checklistTemplates ChecklistTemplate[]

  @@unique([organizationId, slug])
  @@unique([industryTemplateId, slug])
  @@index([organizationId])
  @@index([industryTemplateId])
  @@index([serviceCategoryId])
}

model WorkOrderStatus {
  id                 String             @id @default(cuid())
  organizationId     String?
  industryTemplateId String?
  name               String
  slug               String
  lifecycle          WorkOrderLifecycle @default(REQUESTED)
  color              String?
  sortOrder          Int                @default(0)
  isDefault          Boolean            @default(false)
  isTerminal         Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  organization       Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  industryTemplate   IndustryTemplate?  @relation(fields: [industryTemplateId], references: [id])
  workOrders         WorkOrder[]

  @@unique([organizationId, slug])
  @@unique([industryTemplateId, slug])
  @@index([organizationId])
  @@index([industryTemplateId])
}

model WorkOrder {
  id                    String                 @id @default(cuid())
  organizationId        String
  number                String
  customerId            String
  customerLocationId    String?
  assetId               String?
  serviceCategoryId     String?
  serviceItemId         String?
  statusId              String
  checklistTemplateId   String?
  createdById           String?
  title                 String
  description           String?
  customerComplaint     String?
  internalNotes         String?
  jobType               String?
  priority              WorkOrderPriority      @default(NORMAL)
  source                JobSource              @default(PHONE)
  paymentStatus         WorkOrderPaymentStatus @default(NOT_INVOICED)
  requestedAt           DateTime               @default(now())
  preferredStart        DateTime?
  preferredEnd          DateTime?
  scheduledStart        DateTime?
  scheduledEnd          DateTime?
  estimatedDurationMin  Int?
  completedAt           DateTime?
  customFields          Json?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  organization          Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer              Customer               @relation(fields: [customerId], references: [id])
  customerLocation      CustomerLocation?      @relation(fields: [customerLocationId], references: [id])
  asset                 Asset?                 @relation(fields: [assetId], references: [id])
  serviceCategory       ServiceCategory?       @relation(fields: [serviceCategoryId], references: [id])
  serviceItem           ServiceItem?           @relation(fields: [serviceItemId], references: [id])
  status                WorkOrderStatus        @relation(fields: [statusId], references: [id])
  checklistTemplate     ChecklistTemplate?     @relation(fields: [checklistTemplateId], references: [id])
  createdBy             User?                  @relation("WorkOrderCreator", fields: [createdById], references: [id])
  assignments           WorkOrderAssignment[]
  checklistResponses    JobChecklistResponse[]
  quotes                Quote[]
  invoices              Invoice[]
  inventoryTransactions InventoryTransaction[]
  followUps             FollowUpReminder[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([customerId])
  @@index([customerLocationId])
  @@index([assetId])
  @@index([statusId])
  @@index([scheduledStart])
  @@index([preferredStart])
  @@index([paymentStatus])
}

model WorkOrderAssignment {
  id                  String            @id @default(cuid())
  organizationId      String
  workOrderId         String
  technicianProfileId String
  assignedById        String?
  status              AssignmentStatus  @default(ASSIGNED)
  assignedAt          DateTime          @default(now())
  acceptedAt          DateTime?
  completedAt         DateTime?
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrder           WorkOrder         @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  technicianProfile   TechnicianProfile @relation(fields: [technicianProfileId], references: [id])
  assignedBy          User?             @relation("AssignmentCreator", fields: [assignedById], references: [id])

  @@index([organizationId])
  @@index([workOrderId])
  @@index([technicianProfileId])
  @@index([assignedById])
}

model TechnicianProfile {
  id                 String                 @id @default(cuid())
  organizationId     String
  userId             String
  displayName        String
  phone              String?
  serviceArea        String?
  skills             String[]               @default([])
  hourlyCost         Decimal?               @db.Decimal(12, 2)
  active             Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments        WorkOrderAssignment[]
  checklistResponses JobChecklistResponse[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
}

model ChecklistTemplate {
  id                 String            @id @default(cuid())
  organizationId     String?
  industryTemplateId String?
  serviceCategoryId  String?
  serviceItemId      String?
  name               String
  slug               String
  jobType            String?
  description        String?
  required           Boolean           @default(false)
  active             Boolean           @default(true)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  organization       Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  industryTemplate   IndustryTemplate? @relation(fields: [industryTemplateId], references: [id])
  serviceCategory    ServiceCategory?  @relation(fields: [serviceCategoryId], references: [id])
  serviceItem        ServiceItem?      @relation(fields: [serviceItemId], references: [id])
  items              ChecklistItem[]
  workOrders         WorkOrder[]

  @@unique([organizationId, slug])
  @@unique([industryTemplateId, slug])
  @@index([organizationId])
  @@index([industryTemplateId])
  @@index([serviceCategoryId])
  @@index([serviceItemId])
}

model ChecklistItem {
  id                  String                 @id @default(cuid())
  checklistTemplateId String
  label               String
  helpText            String?
  type                ChecklistItemType      @default(BOOLEAN)
  required            Boolean                @default(false)
  sortOrder           Int                    @default(0)
  options             Json?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  checklistTemplate   ChecklistTemplate      @relation(fields: [checklistTemplateId], references: [id], onDelete: Cascade)
  responses           JobChecklistResponse[]

  @@index([checklistTemplateId])
}

model JobChecklistResponse {
  id                  String                   @id @default(cuid())
  organizationId      String
  workOrderId         String
  checklistItemId     String
  technicianProfileId String?
  status              ChecklistResponseStatus?
  value               Json?
  note                String?
  completedAt         DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workOrder           WorkOrder                @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  checklistItem       ChecklistItem            @relation(fields: [checklistItemId], references: [id], onDelete: Cascade)
  technicianProfile   TechnicianProfile?       @relation(fields: [technicianProfileId], references: [id])

  @@unique([workOrderId, checklistItemId])
  @@index([organizationId])
  @@index([technicianProfileId])
}

model Quote {
  id                 String             @id @default(cuid())
  organizationId     String
  number             String
  customerId         String
  customerLocationId String?
  workOrderId        String?
  status             QuoteStatus        @default(DRAFT)
  title              String
  notes              String?
  subtotal           Decimal            @default(0) @db.Decimal(12, 2)
  taxAmount          Decimal            @default(0) @db.Decimal(12, 2)
  discountAmount     Decimal            @default(0) @db.Decimal(12, 2)
  total              Decimal            @default(0) @db.Decimal(12, 2)
  expiresAt          DateTime?
  sentAt             DateTime?
  approvedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer           Customer           @relation(fields: [customerId], references: [id])
  customerLocation   CustomerLocation?  @relation(fields: [customerLocationId], references: [id])
  workOrder          WorkOrder?         @relation(fields: [workOrderId], references: [id])
  lineItems          QuoteLineItem[]
  invoices           Invoice[]
  followUps          FollowUpReminder[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([customerId])
  @@index([workOrderId])
}

model QuoteLineItem {
  id             String       @id @default(cuid())
  organizationId String
  quoteId        String
  serviceItemId  String?
  description    String
  quantity       Decimal      @default(1) @db.Decimal(10, 2)
  unitPrice      Decimal      @default(0) @db.Decimal(12, 2)
  taxRate        Decimal      @default(0) @db.Decimal(5, 2)
  total          Decimal      @default(0) @db.Decimal(12, 2)
  sortOrder      Int          @default(0)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  quote          Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  serviceItem    ServiceItem? @relation(fields: [serviceItemId], references: [id])

  @@index([organizationId])
  @@index([quoteId])
  @@index([serviceItemId])
}

model Invoice {
  id                 String             @id @default(cuid())
  organizationId     String
  number             String
  customerId         String
  customerLocationId String?
  quoteId            String?
  workOrderId        String?
  status             InvoiceStatus      @default(DRAFT)
  subtotal           Decimal            @default(0) @db.Decimal(12, 2)
  taxAmount          Decimal            @default(0) @db.Decimal(12, 2)
  discountAmount     Decimal            @default(0) @db.Decimal(12, 2)
  total              Decimal            @default(0) @db.Decimal(12, 2)
  balanceDue         Decimal            @default(0) @db.Decimal(12, 2)
  issuedAt           DateTime?
  dueAt              DateTime?
  paidAt             DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer           Customer           @relation(fields: [customerId], references: [id])
  customerLocation   CustomerLocation?  @relation(fields: [customerLocationId], references: [id])
  quote              Quote?             @relation(fields: [quoteId], references: [id])
  workOrder          WorkOrder?         @relation(fields: [workOrderId], references: [id])
  lineItems          InvoiceLineItem[]
  payments           Payment[]
  followUps          FollowUpReminder[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([customerId])
  @@index([quoteId])
  @@index([workOrderId])
}

model InvoiceLineItem {
  id             String       @id @default(cuid())
  organizationId String
  invoiceId      String
  serviceItemId  String?
  description    String
  quantity       Decimal      @default(1) @db.Decimal(10, 2)
  unitPrice      Decimal      @default(0) @db.Decimal(12, 2)
  taxRate        Decimal      @default(0) @db.Decimal(5, 2)
  total          Decimal      @default(0) @db.Decimal(12, 2)
  sortOrder      Int          @default(0)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceItem    ServiceItem? @relation(fields: [serviceItemId], references: [id])

  @@index([organizationId])
  @@index([invoiceId])
  @@index([serviceItemId])
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  invoiceId      String
  customerId     String
  status         PaymentStatus @default(PENDING)
  method         PaymentMethod @default(CASH)
  amount         Decimal       @db.Decimal(12, 2)
  reference      String?
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice        Invoice       @relation(fields: [invoiceId], references: [id])
  customer       Customer      @relation(fields: [customerId], references: [id])

  @@index([organizationId])
  @@index([invoiceId])
  @@index([customerId])
}

model InventoryItem {
  id             String                 @id @default(cuid())
  organizationId String
  sku            String
  name           String
  category       String?
  unit           String                 @default("each")
  quantityOnHand Decimal                @default(0) @db.Decimal(12, 2)
  reorderPoint   Decimal                @default(0) @db.Decimal(12, 2)
  defaultCost    Decimal?               @db.Decimal(12, 2)
  active         Boolean                @default(true)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions   InventoryTransaction[]

  @@unique([organizationId, sku])
  @@index([organizationId])
}

model InventoryTransaction {
  id              String                   @id @default(cuid())
  organizationId  String
  inventoryItemId String
  workOrderId     String?
  createdById     String?
  type            InventoryTransactionType
  quantity        Decimal                  @db.Decimal(12, 2)
  unitCost        Decimal?                 @db.Decimal(12, 2)
  notes           String?
  createdAt       DateTime                 @default(now())
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem            @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  workOrder       WorkOrder?               @relation(fields: [workOrderId], references: [id])
  createdBy       User?                    @relation("InventoryTransactionCreator", fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([inventoryItemId])
  @@index([workOrderId])
  @@index([createdById])
}

model Attachment {
  id             String               @id @default(cuid())
  organizationId String
  entityType     AttachmentEntityType
  entityId       String
  fileName       String
  mimeType       String
  url            String
  sizeBytes      Int?
  createdAt      DateTime             @default(now())
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([entityType, entityId])
}

model Note {
  id             String         @id @default(cuid())
  organizationId String
  entityType     NoteEntityType
  entityId       String
  authorId       String?
  body           String
  pinned         Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author         User?          @relation("NoteAuthor", fields: [authorId], references: [id])

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([authorId])
}

model ActivityLog {
  id             String             @id @default(cuid())
  organizationId String
  actorId        String?
  entityType     ActivityEntityType
  entityId       String
  action         String
  message        String?
  metadata       Json?
  createdAt      DateTime           @default(now())
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          User?              @relation("ActivityActor", fields: [actorId], references: [id])

  @@index([organizationId])
  @@index([actorId])
  @@index([entityType, entityId])
}

model NotificationTemplate {
  id                 String              @id @default(cuid())
  organizationId     String?
  industryTemplateId String?
  name               String
  slug               String
  channel            NotificationChannel
  trigger            NotificationTrigger
  subject            String?
  body               String
  variables          Json?
  active             Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organization       Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  industryTemplate   IndustryTemplate?   @relation(fields: [industryTemplateId], references: [id])

  @@unique([organizationId, slug])
  @@unique([industryTemplateId, slug])
  @@index([organizationId])
  @@index([industryTemplateId])
}

model FollowUpReminder {
  id             String       @id @default(cuid())
  organizationId String
  customerId     String?
  workOrderId    String?
  quoteId        String?
  invoiceId      String?
  ownerId        String?
  title          String
  notes          String?
  dueAt          DateTime
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer?    @relation(fields: [customerId], references: [id])
  workOrder      WorkOrder?   @relation(fields: [workOrderId], references: [id])
  quote          Quote?       @relation(fields: [quoteId], references: [id])
  invoice        Invoice?     @relation(fields: [invoiceId], references: [id])
  owner          User?        @relation("FollowUpOwner", fields: [ownerId], references: [id])

  @@index([organizationId])
  @@index([customerId])
  @@index([workOrderId])
  @@index([quoteId])
  @@index([invoiceId])
  @@index([ownerId])
}

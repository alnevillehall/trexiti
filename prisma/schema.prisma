generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum RoleKey {
  PLATFORM_OWNER
  COMPANY_ADMIN
  DISPATCHER
  TECHNICIAN
  SALES
  ACCOUNTANT
}

enum CustomerType {
  RESIDENTIAL
  COMMERCIAL
  PROPERTY_MANAGER
  LANDLORD
  TENANT
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  PROSPECT
  ARCHIVED
}

enum AssetStatus {
  ACTIVE
  INACTIVE
  NEEDS_REPLACEMENT
}

enum WorkOrderPriority {
  LOW
  NORMAL
  HIGH
  URGENT
  EMERGENCY
}

enum WorkOrderLifecycle {
  REQUESTED
  SCHEDULED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum JobSource {
  PHONE
  WHATSAPP
  WALK_IN
  WEBSITE
  REFERRAL
  REPEAT_CUSTOMER
  OTHER
}

enum WorkOrderPaymentStatus {
  NOT_INVOICED
  INVOICED
  PARTIALLY_PAID
  PAID
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  EN_ROUTE
  ON_SITE
  COMPLETED
  REASSIGNED
}

enum ChecklistItemType {
  BOOLEAN
  TEXT
  NUMBER
  PHOTO
  SIGNATURE
  SINGLE_SELECT
  MULTI_SELECT
}

enum ConfigFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN
  SELECT
  MULTI_SELECT
}

enum ChecklistResponseStatus {
  PASS
  FAIL
  NOT_APPLICABLE
}

enum QuoteStatus {
  DRAFT
  SENT
  APPROVED
  DECLINED
  EXPIRED
  CONVERTED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CASH
  CARD
  BANK_TRANSFER
  CHEQUE
  MOBILE_MONEY
  OTHER
}

enum InventoryTransactionType {
  PURCHASE
  USE
  RETURN
  ADJUSTMENT
  TRANSFER
}

enum AttachmentEntityType {
  CUSTOMER
  CUSTOMER_LOCATION
  ASSET
  WORK_ORDER
  QUOTE
  INVOICE
  PAYMENT
}

enum NoteEntityType {
  CUSTOMER
  CUSTOMER_LOCATION
  ASSET
  WORK_ORDER
  QUOTE
  INVOICE
  PAYMENT
}

enum ActivityEntityType {
  ORGANIZATION
  CUSTOMER
  CUSTOMER_LOCATION
  ASSET
  WORK_ORDER
  QUOTE
  INVOICE
  PAYMENT
  INVENTORY_ITEM
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

enum NotificationTrigger {
  JOB_CREATED
  JOB_ASSIGNED
  JOB_REMINDER
  QUOTE_SENT
  INVOICE_SENT
  PAYMENT_RECEIVED
  FOLLOW_UP_DUE
}

enum ProjectLeadStatus {
  NEW
  REVIEWING
  QUALIFIED
  DISCOVERY
  PROPOSAL
  WON
  LOST
}

enum AdminRole {
  OWNER
  ADMIN
  SALES
}

enum AdminCompanyStatus {
  TARGET
  ACTIVE
  CLIENT
  DORMANT
  ARCHIVED
}

enum AdminOpportunityDirection {
  INBOUND
  OUTBOUND
}

enum AdminOpportunityStage {
  RESEARCHING
  CONTACTED
  REPLIED
  QUALIFIED
  DISCOVERY
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum AdminOpportunityType {
  WEBSITE_REDESIGN
  PROPERTY_PLATFORM
  CUSTOMER_PORTAL
  BUSINESS_SYSTEM
  OPERATIONS_PLATFORM
  CRM
  AUTOMATION
  INTEGRATION
  CUSTOM_SOFTWARE
  OTHER
}

enum AdminTaskType {
  CALL
  EMAIL
  LINKEDIN
  RESEARCH
  PROPOSAL
  FOLLOW_UP
  MEETING
}

enum AdminTaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AdminTaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum AdminActivityKind {
  CREATED
  UPDATED
  STAGE_CHANGED
  NOTE_ADDED
  MESSAGE_LOGGED
  TASK_CREATED
  PROPOSAL_UPDATED
  ASSIGNED
  ARCHIVED
  RESTORED
  RESEARCH_COMPLETED
  OUTREACH_STEP_COMPLETED
  REPLY_ACTIONED
}

enum AdminOutreachChannel {
  EMAIL
  LINKEDIN
  INSTAGRAM
  PHONE
  WHATSAPP
  REFERRAL
  OTHER
}

enum AdminMessageDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum AdminOutreachStepStatus {
  PENDING
  READY
  COMPLETED
  SKIPPED
}

enum AdminProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
}

enum AdminAuditAction {
  CREATE
  UPDATE
  ARCHIVE
  RESTORE
}

enum MarketingContentStatus {
  IDEA
  DRAFTING
  REVIEW
  READY
  SCHEDULED
  PUBLISHED
  REPURPOSED
  ARCHIVED
}

enum MarketingContentType {
  TEXT_POST
  CAROUSEL
  VIDEO
  ARTICLE
  CASE_STUDY
  EMAIL
  WHATSAPP_STATUS
  PROFILE_UPDATE
  LANDING_PAGE
}

enum MarketingPillar {
  BUSINESS_SYSTEMS
  OPERATIONAL_DESIGN
  DIGITAL_EXPERIENCE
  BUILD_VS_BUY
  AUTOMATION
  BEHIND_THE_WORK
  SMALL_BUSINESS
}

enum MarketingChannel {
  LINKEDIN_FOUNDER
  LINKEDIN_COMPANY
  INSTAGRAM
  WEBSITE_INSIGHTS
  EMAIL
  WHATSAPP
  GOOGLE_BUSINESS_PROFILE
}

enum MarketingCampaignStatus {
  PLANNED
  ACTIVE
  PAUSED
  COMPLETE
  ARCHIVED
}

enum MarketingAssetStatus {
  REQUESTED
  IN_PRODUCTION
  REVIEW
  READY
  ARCHIVED
}

enum MarketingAssetTemplate {
  BRAND_STATEMENT
  SYSTEM_FLOW
  FRAGMENTED_CONNECTED
  INSIGHT_ARTICLE
  CAROUSEL
  CASE_STUDY
  FOCUSED_BUILD
  SYSTEMS_REVIEW
}

enum MarketingAssetFormat {
  LINKEDIN_FEED
  LINKEDIN_SQUARE
  INSTAGRAM_PORTRAIT
  INSTAGRAM_SQUARE
  INSTAGRAM_STORY
  LINKEDIN_PERSONAL_COVER
  LINKEDIN_COMPANY_COVER
  LOGO_AVATAR
  OPEN_GRAPH
}

enum MarketingAssetVariant {
  LIGHT
  DARK
}

enum MarketingChannelProfileStatus {
  NOT_STARTED
  IN_PROGRESS
  READY
  NEEDS_REVIEW
}

enum MarketingVerificationStatus {
  UNCHECKED
  PENDING
  VERIFIED
  NOT_AVAILABLE
}

enum MarketingMetricEntrySource {
  MANUAL
  IMPORTED
}

enum MarketingLaunchChecklistStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  COMPLETE
}

model ProjectLead {
  id                     String            @id @default(cuid())
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  status                 ProjectLeadStatus @default(NEW)
  name                   String
  email                  String
  phone                  String?
  role                   String
  companyName            String
  companyWebsite         String?
  industry               String
  companySize            String?
  companyStage           String?
  teamSize               String?
  location               String
  customerServiceArea    String?
  projectType            String
  objectives             String[]
  challenge              String            @db.Text
  currentState           String?           @db.Text
  friction               String?           @db.Text
  existingSystems        String[]
  importantTools         String?           @db.Text
  engagementShape        String?
  budgetRange            String
  investmentContext      String?
  investmentNotes        String?           @db.Text
  timeline               String
  preferredContactMethod String?
  consentedAt            DateTime
  source                 String            @default("trexiti_website")
  utmSource              String?
  utmMedium              String?
  utmCampaign            String?
  firstTouchSource       String?
  firstTouchMedium       String?
  firstTouchCampaign     String?
  firstTouchContent      String?
  firstTouchTerm         String?
  firstTouchAt           DateTime?
  lastTouchSource        String?
  lastTouchMedium        String?
  lastTouchCampaign      String?
  lastTouchContent       String?
  lastTouchTerm          String?
  lastTouchAt            DateTime?
  landingPage            String?
  referrer               String?
  isReturning            Boolean           @default(false)
  qualificationSummary   String?           @db.Text
  nextAction             String?           @db.Text
  requestFingerprint     String?
  opportunity            AdminOpportunity?

  @@index([status, createdAt])
  @@index([email, createdAt])
  @@index([requestFingerprint, createdAt])
  @@index([firstTouchSource, createdAt])
}

model MarketingEvent {
  id                 String   @id @default(cuid())
  receivedAt         DateTime @default(now())
  occurredAt         DateTime
  name               String
  route              String
  sessionId          String
  properties         Json?
  firstTouchSource   String
  firstTouchMedium   String
  firstTouchCampaign String?
  firstTouchContent  String?
  firstTouchTerm     String?
  firstTouchAt       DateTime
  lastTouchSource    String
  lastTouchMedium    String
  lastTouchCampaign  String?
  lastTouchContent   String?
  lastTouchTerm      String?
  lastTouchAt        DateTime
  landingPage        String
  referrer           String?
  isReturning        Boolean  @default(false)

  @@index([name, occurredAt])
  @@index([sessionId, occurredAt])
  @@index([firstTouchSource, occurredAt])
  @@index([route, occurredAt])
}

model AdminUser {
  id                    String                  @id @default(cuid())
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  lastSignedInAt        DateTime?
  externalAuthId        String                  @unique
  email                 String                  @unique
  name                  String
  role                  AdminRole               @default(SALES)
  active                Boolean                 @default(true)
  assignedOpportunities AdminOpportunity[]      @relation("AdminOpportunityOwner")
  assignedTasks         AdminTask[]             @relation("AdminTaskOwner")
  authoredNotes         AdminOpportunityNote[]
  activities            AdminActivity[]
  messages              AdminMessage[]
  proposals             AdminProposal[]
  auditLogs             AdminAuditLog[]
  dailyTargetConfig     AdminDailyTargetConfig?

  @@index([active, role])
}

model AdminCompany {
  id            String             @id @default(cuid())
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  archivedAt    DateTime?
  status        AdminCompanyStatus @default(TARGET)
  name          String
  domain        String             @unique
  website       String?
  industry      String
  country       String
  estimatedSize String?
  phone         String?
  notes         String?            @db.Text
  lifetimeValue Decimal            @default(0) @db.Decimal(14, 2)
  contacts      AdminContact[]
  opportunities AdminOpportunity[]
  tasks         AdminTask[]

  @@index([industry, country])
  @@index([status, createdAt])
  @@index([archivedAt])
}

model AdminContact {
  id              String               @id @default(cuid())
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  archivedAt      DateTime?
  companyId       String
  name            String
  title           String?
  email           String?
  phone           String?
  linkedInUrl     String?
  isDecisionMaker Boolean              @default(false)
  company         AdminCompany         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  opportunities   AdminOpportunity[]
  tasks           AdminTask[]
  contactMethods  AdminContactMethod[]

  @@unique([companyId, email])
  @@index([companyId, isDecisionMaker])
  @@index([email])
  @@index([archivedAt])
}

model AdminContactMethod {
  id         String               @id @default(cuid())
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  contactId  String
  channel    AdminOutreachChannel
  value      String
  label      String?
  preferred  Boolean              @default(false)
  verifiedAt DateTime?
  contact    AdminContact         @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, channel, value])
  @@index([channel, value])
  @@index([contactId, preferred])
}

model AdminOpportunity {
  id                   String                    @id @default(cuid())
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  archivedAt           DateTime?
  reference            String                    @unique
  companyId            String
  primaryContactId     String?
  projectLeadId        String?                   @unique
  assignedOwnerId      String?
  direction            AdminOpportunityDirection
  stage                AdminOpportunityStage     @default(RESEARCHING)
  type                 AdminOpportunityType
  title                String
  source               String
  identifiedProblem    String                    @db.Text
  opportunity          String                    @db.Text
  estimatedValue       Decimal                   @db.Decimal(14, 2)
  budget               String?
  timeline             String?
  outcomeReason        String?                   @db.Text
  probability          Int                       @default(10)
  nextAction           String?                   @db.Text
  nextFollowUp         DateTime?
  reasonForContact     String?                   @db.Text
  personalizationAngle String?                   @db.Text
  company              AdminCompany              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  primaryContact       AdminContact?             @relation(fields: [primaryContactId], references: [id], onDelete: SetNull)
  projectLead          ProjectLead?              @relation(fields: [projectLeadId], references: [id], onDelete: SetNull)
  assignedOwner        AdminUser?                @relation("AdminOpportunityOwner", fields: [assignedOwnerId], references: [id], onDelete: SetNull)
  research             AdminProspectResearch?
  activities           AdminActivity[]
  notes                AdminOpportunityNote[]
  messages             AdminMessage[]
  proposals            AdminProposal[]
  tasks                AdminTask[]
  outreachSequence     AdminOutreachSequence?

  @@index([stage, nextFollowUp])
  @@index([assignedOwnerId, stage])
  @@index([companyId, stage])
  @@index([direction, createdAt])
  @@index([estimatedValue])
  @@index([archivedAt])
}

model AdminProspectResearch {
  id                        String           @id @default(cuid())
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  opportunityId             String           @unique
  currentWebsiteQuality     Int?
  operationalMaturity       Int?
  observedProblems          String?          @db.Text
  recentBusinessActivity    String?          @db.Text
  notes                     String?          @db.Text
  financialCapacityScore    Int              @default(1)
  problemSeverityScore      Int              @default(1)
  strategicFitScore         Int              @default(1)
  urgencyScore              Int              @default(1)
  decisionMakerAccessScore  Int              @default(1)
  totalScore                Int              @default(5)
  websiteReviewed           Boolean          @default(false)
  mobileReviewed            Boolean          @default(false)
  businessModelUnderstood   Boolean          @default(false)
  decisionMakerIdentified   Boolean          @default(false)
  specificProblemIdentified Boolean          @default(false)
  personalizationPrepared   Boolean          @default(false)
  contactMethodFound        Boolean          @default(false)
  readyForOutreachAt        DateTime?
  opportunity               AdminOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([totalScore])
  @@index([readyForOutreachAt])
}

model AdminTask {
  id            String            @id @default(cuid())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  completedAt   DateTime?
  archivedAt    DateTime?
  opportunityId String?
  companyId     String?
  contactId     String?
  ownerId       String
  type          AdminTaskType
  priority      AdminTaskPriority @default(MEDIUM)
  status        AdminTaskStatus   @default(TODO)
  title         String
  dueAt         DateTime
  notes         String?           @db.Text
  opportunity   AdminOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  company       AdminCompany?     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contact       AdminContact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner         AdminUser         @relation("AdminTaskOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  @@index([ownerId, status, dueAt])
  @@index([opportunityId, status])
  @@index([companyId])
  @@index([priority, dueAt])
  @@index([archivedAt])
}

model AdminOpportunityNote {
  id            String           @id @default(cuid())
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  opportunityId String
  authorId      String
  body          String           @db.Text
  opportunity   AdminOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  author        AdminUser        @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([opportunityId, createdAt])
  @@index([authorId])
}

model AdminActivity {
  id            String            @id @default(cuid())
  createdAt     DateTime          @default(now())
  occurredAt    DateTime          @default(now())
  opportunityId String
  actorId       String?
  kind          AdminActivityKind
  summary       String
  metadata      Json?
  opportunity   AdminOpportunity  @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  actor         AdminUser?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([opportunityId, occurredAt])
  @@index([actorId, occurredAt])
}

model AdminMessage {
  id                String                @id @default(cuid())
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  opportunityId     String
  recordedById      String?
  sequenceStepId    String?               @unique
  channel           AdminOutreachChannel
  direction         AdminMessageDirection
  subject           String?
  body              String                @db.Text
  response          String?               @db.Text
  occurredAt        DateTime              @default(now())
  nextAction        String?               @db.Text
  provider          String?
  externalMessageId String?
  deliveryStatus    String?
  rawMetadata       Json?
  needsAction       Boolean               @default(false)
  actionedAt        DateTime?
  opportunity       AdminOpportunity      @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  recordedBy        AdminUser?            @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  sequenceStep      AdminOutreachStep?    @relation(fields: [sequenceStepId], references: [id], onDelete: SetNull)

  @@index([opportunityId, occurredAt])
  @@index([externalMessageId])
  @@index([provider, deliveryStatus])
  @@index([needsAction, occurredAt])
}

model AdminOutreachSequence {
  id            String              @id @default(cuid())
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  opportunityId String              @unique
  startedAt     DateTime
  pausedAt      DateTime?
  completedAt   DateTime?
  opportunity   AdminOpportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  steps         AdminOutreachStep[]

  @@index([startedAt, completedAt])
}

model AdminOutreachStep {
  id           String                  @id @default(cuid())
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  sequenceId   String
  stepNumber   Int
  dayOffset    Int
  label        String
  scheduledFor DateTime
  status       AdminOutreachStepStatus @default(PENDING)
  completedAt  DateTime?
  channel      AdminOutreachChannel?
  notes        String?                 @db.Text
  sequence     AdminOutreachSequence   @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  message      AdminMessage?

  @@unique([sequenceId, stepNumber])
  @@index([status, scheduledFor])
}

model AdminDailyTargetConfig {
  id                         String    @id @default(cuid())
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt
  userId                     String    @unique
  researchTarget             Int       @default(10)
  personalizedOutreachTarget Int       @default(20)
  followUpTarget             Int       @default(10)
  user                       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminProposal {
  id            String              @id @default(cuid())
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  opportunityId String
  createdById   String?
  version       Int                 @default(1)
  title         String
  amount        Decimal             @db.Decimal(14, 2)
  status        AdminProposalStatus @default(DRAFT)
  documentUrl   String?
  notes         String?             @db.Text
  sentAt        DateTime?
  validUntil    DateTime?
  opportunity   AdminOpportunity    @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  createdBy     AdminUser?          @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([opportunityId, version])
  @@index([status, sentAt])
  @@index([createdById])
}

model AdminAuditLog {
  id         String           @id @default(cuid())
  createdAt  DateTime         @default(now())
  actorId    String?
  action     AdminAuditAction
  entityType String
  entityId   String
  summary    String
  before     Json?
  after      Json?
  metadata   Json?
  actor      AdminUser?       @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
}

model MarketingCampaign {
  id                   String                      @id @default(cuid())
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  seedKey              String?                     @unique
  name                 String
  objective            String                      @db.Text
  audience             String                      @db.Text
  message              String                      @db.Text
  offer                String                      @db.Text
  startAt              DateTime
  endAt                DateTime
  status               MarketingCampaignStatus     @default(PLANNED)
  primaryCta           String
  landingPage          String?
  utmSource            String?
  utmMedium            String?
  utmCampaign          String?
  targetAccountSegment String?                     @db.Text
  targetMetrics        Json?
  actualMetrics        Json?
  notes                String?                     @db.Text
  content              MarketingContent[]
  assets               MarketingAsset[]
  metrics              MarketingWeeklyMetric[]
  outboundActivities   MarketingOutboundActivity[]

  @@index([status, startAt, endAt])
}

model MarketingContent {
  id                String                 @id @default(cuid())
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  seedKey           String?                @unique
  title             String
  coreIdea          String                 @db.Text
  contentType       MarketingContentType
  pillar            MarketingPillar
  status            MarketingContentStatus @default(IDEA)
  primaryChannel    MarketingChannel
  secondaryChannels MarketingChannel[]
  publishAt         DateTime?
  publishedAt       DateTime?
  owner             String
  body              String                 @db.Text
  shortCaption      String?                @db.Text
  cta               String?
  destinationUrl    String?
  assetBrief        String?                @db.Text
  sourceArticleId   String?
  campaignId        String?
  parentContentId   String?
  canonicalPostUrl  String?
  notes             String?                @db.Text
  campaign          MarketingCampaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  parentContent     MarketingContent?      @relation("MarketingContentRepurposing", fields: [parentContentId], references: [id], onDelete: SetNull)
  repurposedContent MarketingContent[]     @relation("MarketingContentRepurposing")
  assets            MarketingAsset[]

  @@index([status, publishAt])
  @@index([primaryChannel, publishAt])
  @@index([pillar, publishAt])
  @@index([campaignId, publishAt])
  @@index([parentContentId])
}

model MarketingAsset {
  id             String                  @id @default(cuid())
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  seedKey        String?                 @unique
  name           String
  kind           String
  status         MarketingAssetStatus    @default(REQUESTED)
  channel        MarketingChannel?
  dueAt          DateTime?
  brief          String                  @db.Text
  assetUrl       String?
  owner          String?
  notes          String?                 @db.Text
  template       MarketingAssetTemplate?
  format         MarketingAssetFormat?
  variant        MarketingAssetVariant?
  title          String?
  eyebrow        String?
  body           String?                 @db.Text
  cta            String?
  altText        String?                 @db.Text
  slideCount     Int                     @default(1)
  slides         Json?
  systemNodes    String[]                @default([])
  destinationUrl String?
  exportWidth    Int?
  exportHeight   Int?
  lastExportedAt DateTime?
  campaignId     String?
  contentId      String?
  campaign       MarketingCampaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  content        MarketingContent?       @relation(fields: [contentId], references: [id], onDelete: SetNull)

  @@index([status, dueAt])
  @@index([campaignId])
  @@index([contentId])
}

model MarketingChannelProfile {
  id                 String                        @id @default(cuid())
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  channel            MarketingChannel              @unique
  profileUrl         String?
  status             MarketingChannelProfileStatus @default(NOT_STARTED)
  bioComplete        Boolean                       @default(false)
  logoComplete       Boolean                       @default(false)
  bannerComplete     Boolean                       @default(false)
  ctaLinkComplete    Boolean                       @default(false)
  verificationStatus MarketingVerificationStatus   @default(UNCHECKED)
  lastReviewedAt     DateTime?
  notes              String?                       @db.Text

  @@index([status, lastReviewedAt])
}

model MarketingWeeklyMetric {
  id                     String                     @id @default(cuid())
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  seedKey                String?                    @unique
  weekStarting           DateTime
  channel                MarketingChannel?
  campaignId             String?
  source                 MarketingMetricEntrySource @default(MANUAL)
  impressions            Int                        @default(0)
  reach                  Int                        @default(0)
  profileViews           Int                        @default(0)
  websiteClicks          Int                        @default(0)
  comments               Int                        @default(0)
  saves                  Int                        @default(0)
  directMessages         Int                        @default(0)
  emailReplies           Int                        @default(0)
  qualifiedConversations Int                        @default(0)
  discoveryCalls         Int                        @default(0)
  opportunities          Int                        @default(0)
  wonRevenue             Decimal                    @default(0) @db.Decimal(14, 2)
  notes                  String?                    @db.Text
  campaign               MarketingCampaign?         @relation(fields: [campaignId], references: [id], onDelete: SetNull)

  @@index([weekStarting, channel])
  @@index([campaignId, weekStarting])
}

model MarketingOutboundActivity {
  id         String            @id @default(cuid())
  createdAt  DateTime          @default(now())

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trexiti_service_os?schema=public"

# Required in production for signed project-form sessions and privacy-preserving
# submission fingerprints. Generate at least 32 random characters.
PROJECT_LEAD_FORM_SECRET="replace-with-a-long-random-secret"

# Public canonical origin for the primary Trexiti application.
NEXT_PUBLIC_TREXITI_SITE_URL="https://trexiti.com"

# ServiceOS is dormant. Leave this false unless product work is explicitly resumed.
# When true, workspace demo access is still accepted only outside production;
# production workspace routes fail closed until tenant-aware authentication exists.
TREXITI_SERVICE_OS_ENABLED="false"
NEXT_PUBLIC_AUTH_PROVIDER="development"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"

# Required to expose /admin. Without both Clerk keys the complete admin route
# tree fails closed with a 404. Authenticated identities must also be allow-listed
# in AdminUser using their Clerk user ID.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
ADMIN_SEED_CLERK_USER_ID=""
ADMIN_SEED_EMAIL="owner@trexiti.com"
ADMIN_SEED_NAME="Trexiti Owner"

# Optional official Trexiti WhatsApp number in international format, digits only.
# Leave blank until an authorized number is available; no WhatsApp CTA is shown.
NEXT_PUBLIC_TREXITI_WHATSAPP_NUMBER=""

# Public Trexiti contact and social profiles. LinkedIn links remain hidden until
# an official URL is supplied. Instagram and email use the values below.
NEXT_PUBLIC_TREXITI_CONTACT_EMAIL="hello@trexiti.com"
NEXT_PUBLIC_TREXITI_LINKEDIN_COMPANY_URL=""
NEXT_PUBLIC_AL_NEVILLE_HALL_LINKEDIN_URL=""
NEXT_PUBLIC_TREXITI_INSTAGRAM_URL="https://www.instagram.com/trexiti/"

# Optional, consent-gated first-party marketing analytics. Leave blank to
# disable event collection completely. No third-party SDK is installed.
NEXT_PUBLIC_TREXITI_ANALYTICS_PROVIDER=""
